# Docker Desktop local ports. Port 3307 avoids a common conflict with a
# MySQL instance installed directly on Windows.
HOST_BIND=127.0.0.1
APP_PORT=8088
BACKEND_PORT=8080
MYSQL_PORT=3307
ELASTICSEARCH_PORT=9200

MYSQL_ROOT_PASSWORD=reading_root
MYSQL_DATABASE=reading_agent
MYSQL_USER=reading
MYSQL_PASSWORD=reading_pass

# Keep AI disabled until a DashScope API key is configured.
AI_ENABLED=false
AI_MODEL_CHAT=none
AI_MODEL_EMBEDDING=none
AI_VECTORSTORE_TYPE=none
MCP_ENABLED=true
SPRING_AUTOCONFIGURE_EXCLUDE=org.springframework.ai.vectorstore.elasticsearch.autoconfigure.ElasticsearchVectorStoreAutoConfiguration

DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_CHAT_COMPLETIONS_PATH=/chat/completions
QWEN_EMBEDDINGS_PATH=/embeddings
QWEN_MODEL=qwen-plus
QWEN_EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIMENSIONS=1024
ES_HEAP_SIZE=1g

VITE_API_BASE=/api
CORS_ORIGIN=http://localhost:8088,http://127.0.0.1:8088
